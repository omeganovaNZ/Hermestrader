# Credentials & secrets
# Glob, not a filename list: naming each account file individually meant a NEW
# account config was committable until someone remembered to add a line. The
# example template is the only config file that belongs in git.
alpaca_config*.txt
!alpaca_config.example.txt
*.env
.env
config.ini

# OS junk
NTUSER.DAT*
ntuser.ini
ntuser.dat.LOG*
Desktop/
Documents/
Downloads/
Pictures/
Music/
Videos/
AppData/
Local Settings/
Cookies/
Recent/
Saved Games/
Searches/
SendTo/
Start Menu/
Favorites/
Links/
OneDrive/
3D Objects/
Contacts/
Application Data/
Tracing/
Folding at Home/

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
.ipynb_checkpoints/

# OS junk
.DS_Store
Thumbs.db

